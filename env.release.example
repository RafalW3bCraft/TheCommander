# Copy to .env only for a fresh installation. Preserve existing .env otherwise.
DATABASE_URL=postgresql://commander@127.0.0.1:5432/commander
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
GITHUB_TOKEN=
GITHUB_REPOSITORY=
TAVILY_API_KEY=
# scripts/setup_runtime.py generates ENCRYPTION_KEY, BOOTSTRAP_TOKEN and
# POSTGRES_PASSWORD in .env.runtime. Never commit that file.
# Production: set these in .env.runtime / secret manager, terminate HTTPS:
# PRODUCTION=true
# APP_ORIGIN=https://your-domain.example
MAX_STEPS=5
MAX_OUTPUT_TOKENS=2048
MAX_CONTEXT_CHARS=32000
MAX_RUN_SECONDS=180
MAX_DAILY_RUNS=50
MAX_DAILY_TOKENS=100000
# Optional strict spending cap requires verified model prices:
# DAILY_SPEND_LIMIT_USD=1
# INPUT_USD_PER_MILLION=
# OUTPUT_USD_PER_MILLION=

# Native development: point DATABASE_URL at your existing PostgreSQL server;
# use sslmode=require for a remote TLS-enabled provider. Compose generates its
# isolated database URL in .env.runtime. Do not overwrite existing environments.
# MODEL_ID is a legacy alias for NEBIUS_MODEL; prefer NEBIUS_MODEL in new setups.
# Optional API providers; leave blank to keep Nebius as the only configured provider.
# Select and validate a model explicitly in Settings after configuring its connection.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# INFERENCE_PROVIDER=nebius
# PROVIDER_MODEL=
# No automatic provider fallback. A consumer subscription is not API authorization.

# Optional private Mem0-derived index. Leave both blank to keep canonical recall.
# Use deploy/compose.memory.yaml with separate secrets only after its acceptance gate.
MEMORY_INDEX_URL=
MEMORY_INDEX_TOKEN=
# Overlay-only secrets: MEMORY_ADMIN_PASSWORD, MEMORY_DB_PASSWORD (distinct random values).
