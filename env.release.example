# Copy to .env only for a fresh installation. Preserve existing .env otherwise.
DATABASE_URL=postgresql://commander@127.0.0.1:5432/commander
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
GITHUB_TOKEN=
GITHUB_REPOSITORY=
TAVILY_API_KEY=
# scripts/setup_runtime.py generates ENCRYPTION_KEY, BOOTSTRAP_TOKEN and
# POSTGRES_PASSWORD in .env.runtime. Never commit that file.
# Production: set these in .env.runtime / secret manager, terminate HTTPS:
# PRODUCTION=true
# APP_ORIGIN=https://your-domain.example
MAX_STEPS=5
MAX_OUTPUT_TOKENS=2048
MAX_CONTEXT_CHARS=32000
MAX_RUN_SECONDS=180
MAX_DAILY_RUNS=50
MAX_DAILY_TOKENS=100000
# Optional strict spending cap requires verified model prices:
# DAILY_SPEND_LIMIT_USD=1
# INPUT_USD_PER_MILLION=
# OUTPUT_USD_PER_MILLION=
