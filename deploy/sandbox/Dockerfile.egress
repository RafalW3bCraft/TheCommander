FROM docker.io/library/python:3.13-slim-bookworm@sha256:4cea12ab7d78a3312c85f8cab19b6971d4fe9704da25443986c0bc20a6678850
RUN mkdir -p /opt/commander && chmod 0755 /opt/commander
COPY --chmod=0644 deploy/sandbox/proxy.py /opt/commander/proxy.py
RUN chmod 0755 /opt/commander
USER 10001:10001
ENTRYPOINT ["timeout", "--signal=KILL", "150", "python", "-I", "/opt/commander/proxy.py"]
