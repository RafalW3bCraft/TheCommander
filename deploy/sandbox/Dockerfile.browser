FROM mcr.microsoft.com/playwright/python:v1.64.1-noble@sha256:330d401ae23c905896a0c26c66c36fc971b621519e7b11b435a8328d7bf6e031
RUN mkdir -p /opt/commander && chmod 0755 /opt/commander
RUN pip install --no-cache-dir playwright==1.64.1 && groupadd -g 10001 commander && useradd -u 10001 -g 10001 -m commander
COPY --chmod=0644 deploy/sandbox/browser.py /opt/commander/browser.py
RUN chmod 0755 /opt/commander
USER 10001:10001
