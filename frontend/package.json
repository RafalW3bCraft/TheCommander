{
  "name": "thecommander-ui",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint src e2e *.ts *.js",
    "test:e2e": "playwright test",
    "format": "prettier --write src e2e *.ts *.js package.json tsconfig.json",
    "format:check": "prettier --check src e2e *.ts *.js package.json tsconfig.json",
    "api:types": "openapi-typescript ../docs/openapi.json -o src/api-schema.d.ts && prettier --write src/api-schema.d.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@playwright/test": "^1.56.0",
    "@axe-core/playwright": "^4.10.0",
    "openapi-typescript": "^7.10.0",
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.46.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "prettier": "^3.6.0"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  }
}
